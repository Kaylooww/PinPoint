# Which LLM backs query expansion and answers: openai_compatible | anthropic | none
# (none = extractive mode, no outbound calls)
LLM_PROVIDER=openai_compatible

# Primary: Claude Haiku via the organizers' Open WebUI server (OpenAI-compatible API).
# Base URL up to, not including, /chat/completions. For Open WebUI that is usually https://<host>/api
OPENAI_COMPAT_BASE=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=claude-haiku-5-5

# Fallback: Anthropic API key from the Claude Console
# (a Claude Pro subscription does not include API access).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

LLM_TIMEOUT_SECONDS=45

# Hybrid retrieval: the organizers' OpenAI-compatible embedding server (qwen3-embedding).
# Leave EMBED_BASE empty to use BM25 alone. Not used at all with LLM_PROVIDER=none.
EMBED_BASE=
EMBED_KEY=
EMBED_MODEL=
EMBED_DIMENSIONS=
