# Which LLM backs query expansion and answers: openai_compatible | anthropic | none
# (none = extractive mode, no outbound calls)
LLM_PROVIDER=openai_compatible

# Primary: local Ollama (OpenAI-compatible API); nothing leaves this machine.
# Base URL up to, not including, /chat/completions.
# Ollama: http://localhost:11434/v1, key ollama, model gemma4:e2b
OPENAI_COMPAT_BASE=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=

# Optional cloud provider: Anthropic API key from the Claude Console
# (a Claude Pro subscription does not include API access).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Local generation is slower than a cloud API: 120 for Ollama.
LLM_TIMEOUT_SECONDS=
# Local servers only: thinking is off ("none") for speed; "low" is more careful but 4-10x slower.
LLM_REASONING_EFFORT=

# Hybrid retrieval: an OpenAI-compatible /embeddings endpoint.
# Ollama: http://localhost:11434/v1, key ollama, model embeddinggemma, 768 dimensions, timeout 15
# Leave EMBED_BASE empty to use BM25 alone. Not used at all with LLM_PROVIDER=none.
# Changing EMBED_MODEL re-embeds every workspace in the background on the next start (no re-parse).
EMBED_BASE=
EMBED_KEY=
EMBED_MODEL=
EMBED_DIMENSIONS=
EMBED_TIMEOUT_SECONDS=
